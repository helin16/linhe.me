{
  "name": "linhe-me",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test --test-timeout=30000 --experimental-test-coverage --test-coverage-include='relay/**' --test-coverage-include='src/games/turbo-tumble/net.ts' --test-coverage-exclude='**/*.test.ts' --test-coverage-functions=100 'src/**/*.test.ts' 'relay/**/*.test.ts'",
    "deploy": "node --env-file-if-exists=.env scripts/deploy.ts",
    "relay": "node relay/server.ts",
    "build:relay": "vite build --config vite.relay.config.ts",
    "e2e": "playwright test",
    "e2e:local": "playwright test --project=chromium --project=webkit-ipad"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.128.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.128.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "packageManager": "yarn@4.18.1"
}
