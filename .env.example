# Copy to .env (git-ignored) and fill in. Used by `yarn deploy`.
DEPLOY_TARGET=<user>@<server>:<web-root>/
SITE_URL=https://<domain>/
DEPLOY_RELAY_DIR=<relay-dir>
# Optional relay settings (defaults in relay/config.ts):
# RELAY_PORT=8787
# RELAY_ROOM_SIZE=4
# RELAY_MAX_MESSAGE=8192
# RELAY_RATE=40
# RELAY_PER_ADDRESS=8
# RELAY_MAX_ROOMS=500
# RELAY_PING_MS=30000
# Where the game finds the relay (default: the same site's /relay/):
# VITE_RELAY_URL=wss://<domain>/relay/
# RELAY_LOG_MS=60000
# RELAY_MAX_BUFFER=65536
